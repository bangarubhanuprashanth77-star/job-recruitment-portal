# Flask Configuration
SECRET_KEY=jobconnect-super-secret-key-change-in-production
JWT_SECRET_KEY=jobconnect-jwt-secret-token-key-2026
JWT_EXPIRATION_HOURS=72
FLASK_DEBUG=True
PORT=5000

# Database URI (SQLite for development, PostgreSQL for production)
# Example SQLite: sqlite:///jobconnect.db
# Example PostgreSQL: postgresql://username:password@localhost:5432/jobconnect_db
DATABASE_URL=sqlite:///jobconnect.db

# File Storage
UPLOAD_FOLDER=uploads/resumes
MAX_CONTENT_LENGTH=16777216

# Optional: Gemini API Key for LLM-enhanced contextual analysis
# If left blank, the application automatically uses the built-in smart rule-based engine
GEMINI_API_KEY=
